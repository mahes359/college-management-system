<?xml version="1.0" encoding="UTF-8"?>

<bindings
        xmlns="https://jakarta.ee/xml/ns/jaxb"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jaxb
        https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd"
        version="3.0">

    <bindings schemaLocation="Enrollment.xsd">

        <schemaBindings>

            <package name="com.college.enrollment.soap"/>

        </schemaBindings>

    </bindings>

</bindings>