<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://college.com/exam"
        targetNamespace="http://college.com/exam"
        elementFormDefault="qualified">

    <!-- ================================================= -->
    <!-- CREATE -->
    <!-- ================================================= -->

    <xs:element name="createExamRequest">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="examCode"
                        type="xs:string"/>

                <xs:element
                        name="courseId"
                        type="xs:long"/>

                <xs:element
                        name="examType"
                        type="xs:string"/>

                <xs:element
                        name="examDate"
                        type="xs:string"/>

                <xs:element
                        name="semester"
                        type="xs:int"/>

                <xs:element
                        name="totalMarks"
                        type="xs:int"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <xs:element name="createExamResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="exam"
                        type="tns:exam"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <!-- ================================================= -->
    <!-- GET -->
    <!-- ================================================= -->

    <xs:element name="getExamRequest">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="examId"
                        type="xs:long"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <xs:element name="getExamResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="exam"
                        type="tns:exam"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <!-- ================================================= -->
    <!-- GET ALL -->
    <!-- ================================================= -->

    <xs:element name="getAllExamsRequest">

        <xs:complexType>

            <xs:sequence/>

        </xs:complexType>

    </xs:element>


    <xs:element name="getAllExamsResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="exams"
                        type="tns:exam"
                        minOccurs="0"
                        maxOccurs="unbounded"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <!-- ================================================= -->
    <!-- UPDATE -->
    <!-- ================================================= -->

    <xs:element name="updateExamRequest">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="examId"
                        type="xs:long"/>

                <xs:element
                        name="examCode"
                        type="xs:string"/>

                <xs:element
                        name="courseId"
                        type="xs:long"/>

                <xs:element
                        name="examType"
                        type="xs:string"/>

                <xs:element
                        name="examDate"
                        type="xs:string"/>

                <xs:element
                        name="semester"
                        type="xs:int"/>

                <xs:element
                        name="totalMarks"
                        type="xs:int"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <xs:element name="updateExamResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="exam"
                        type="tns:exam"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <!-- ================================================= -->
    <!-- DELETE -->
    <!-- ================================================= -->

    <xs:element name="deleteExamRequest">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="examId"
                        type="xs:long"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <xs:element name="deleteExamResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="success"
                        type="xs:boolean"/>

                <xs:element
                        name="message"
                        type="xs:string"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <!-- ================================================= -->
    <!-- COMMON EXAM -->
    <!-- ================================================= -->

    <xs:complexType name="exam">

        <xs:sequence>

            <xs:element
                    name="id"
                    type="xs:long"/>

            <xs:element
                    name="examCode"
                    type="xs:string"/>

            <xs:element
                    name="courseId"
                    type="xs:long"/>

            <xs:element
                    name="examType"
                    type="xs:string"/>

            <xs:element
                    name="examDate"
                    type="xs:string"/>

            <xs:element
                    name="semester"
                    type="xs:int"/>

            <xs:element
                    name="totalMarks"
                    type="xs:int"/>

        </xs:sequence>

    </xs:complexType>

</xs:schema>